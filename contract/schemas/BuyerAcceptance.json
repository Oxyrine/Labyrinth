{
  "additionalProperties": false,
  "properties": {
    "acceptance_id": {
      "title": "Acceptance Id",
      "type": "string"
    },
    "accepted_amount_paise": {
      "minimum": 0,
      "title": "Accepted Amount Paise",
      "type": "integer"
    },
    "accepted_at": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$",
      "title": "Accepted At",
      "type": "string"
    },
    "buyer_id": {
      "title": "Buyer Id",
      "type": "string"
    },
    "decision": {
      "default": "accept",
      "enum": [
        "accept",
        "reject"
      ],
      "title": "Decision",
      "type": "string"
    },
    "invoice_id": {
      "pattern": "^INV-[A-Za-z0-9_-]+$",
      "title": "Invoice Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "signature_hex": {
      "title": "Signature Hex",
      "type": "string"
    },
    "version_id": {
      "pattern": "^V-[A-Za-z0-9_-]+$",
      "title": "Version Id",
      "type": "string"
    }
  },
  "required": [
    "acceptance_id",
    "invoice_id",
    "version_id",
    "buyer_id",
    "accepted_amount_paise",
    "accepted_at",
    "signature_hex"
  ],
  "title": "BuyerAcceptance",
  "type": "object"
}
