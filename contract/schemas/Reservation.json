{
  "$defs": {
    "ReservationState": {
      "enum": [
        "reserved",
        "financed",
        "settled",
        "cancelled",
        "expired"
      ],
      "title": "ReservationState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "amount_paise": {
      "minimum": 0,
      "title": "Amount Paise",
      "type": "integer"
    },
    "created_at": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$",
      "title": "Expires At",
      "type": "string"
    },
    "invoice_identity": {
      "title": "Invoice Identity",
      "type": "string"
    },
    "lender_id": {
      "title": "Lender Id",
      "type": "string"
    },
    "request_id": {
      "pattern": "^REQ-[A-Za-z0-9_-]+$",
      "title": "Request Id",
      "type": "string"
    },
    "reservation_id": {
      "pattern": "^RSV-[A-Za-z0-9_-]+$",
      "title": "Reservation Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seller_id": {
      "title": "Seller Id",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/ReservationState"
    }
  },
  "required": [
    "reservation_id",
    "invoice_identity",
    "request_id",
    "lender_id",
    "seller_id",
    "amount_paise",
    "state",
    "created_at",
    "expires_at"
  ],
  "title": "Reservation",
  "type": "object"
}
